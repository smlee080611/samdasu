[node name="note_5_7" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(0.53696, 0, -0.84361, 0, 1, 0, 0.84361, 0, 0.53696, 10.748, 0.01, 14.763)
title = "간호 일지 — 11월 2일 01:40"
body = "108호 김순자 님, 손가락이 돌처럼 무겁다고 호소.
불 꺼진 병동을 몹시 무서워함.

야간 조명 유지를 요청했으나, 지하 공사로 오늘도 정전 예정이라고 함.

— 야간 근무 윤서"

[node name="note_27_7" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(0.82621, 0, 0.56336, 0, 1, 0, -0.56336, 0, 0.82621, 55.392, 0.01, 15.342)
title = "연구 메모 A-7"
body = "광량 50lx 이하에 6시간 이상 노출되면 피부가 각질화되기 시작함.
빛에 다시 노출하면 가역적.

단, 신경계 회복이 늦음. 몸이 풀린 뒤 한동안 이상행동을 보임.
빛을 피해 어두운 곳으로 이동하는 경향.

원장님께 즉시 보고할 것."

[node name="note_23_2" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(-0.97174, 0, 0.23607, 0, 1, 0, -0.23607, 0, -0.97174, 46.65, 0.01, 5.361)
title = "삐뚤빼뚤한 글씨"
body = "불 끄지 마세요
불 끄면 몸이 무거워요

옆 침대 할아버지가 밤에 일어나서 걸어다녀요
근데 아침에는 돌이에요

엄마 보고 싶어요"

[node name="note_3_11" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(-0.97853, 0, 0.20611, 0, 1, 0, -0.20611, 0, -0.97853, 7.212, 0.01, 22.861)
title = "경비 일지"
body = "02:10 전관 정전. 비상발전기 기동 실패.
02:25 지하 연구동 출입문 잠금 확인.
03:00 1층 순찰. 복도에 환자 다수, 미동 없음.
03:05 무전 응답 없음.

손이 잘 안 움직인다. 랜턴을 입구에 두고"

[node name="note_2_3" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(-0.80557, 0, -0.5925, 0, 1, 0, 0.5925, 0, -0.80557, 5.012, 0.01, 6.944)
title = "연구 메모 A-9"
body = "차광막은 실험 조건 유지를 위한 것. 절대 걷지 말 것.

햇빛(자연광)에 노출되면 실험군 전원 '회복'됨.
실험이 무효가 되므로 병실 차광은 반드시 유지."

[node name="note_29_14" parent="Notes" instance=ExtResource("p_note")]
transform = Transform3D(0.55825, 0, -0.82967, 0, 1, 0, 0.82967, 0, 0.55825, 58.611, 0.01, 29.161)
title = "원무과 안내문"
body = "야간 소등 안내
